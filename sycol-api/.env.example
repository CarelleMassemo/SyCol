# Port d'écoute de l'API
PORT=4000

# URL publique de l'API (sert à construire les liens complets vers les photos
# produit hébergées dans public/). À changer en production (ex: https://api.sycol.fr)
PUBLIC_URL=http://localhost:4000

# Origines autorisées à appeler l'API (séparées par des virgules).
# En local, le frontend Vite tourne sur http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Clé secrète à envoyer dans l'en-tête "x-admin-key" pour les routes
# d'administration (créer/modifier/supprimer produits, services, équipe,
# lire les messages de contact). Changez cette valeur avant de déployer !
ADMIN_KEY=change-moi-en-un-secret-fort

# Clé secrète utilisée pour signer les sessions de connexion des comptes
# clients (voir src/auth.js). Si absente, ADMIN_KEY est réutilisé pour ne pas
# bloquer le démarrage — mettez une vraie valeur distincte en production.
AUTH_SECRET=change-moi-aussi-en-un-autre-secret-fort

# --- Envoi d'emails (notification à l'admin + réponse au client) ---
#
# Adresse qui reçoit une notification à chaque message de contact / demande
# de devis :
ADMIN_EMAIL=carellemassemo@gmail.com
#
# OPTION A (recommandée, plus simple) — Resend :
#   1. Créez un compte gratuit sur https://resend.com avec l'adresse
#      carellemassemo@gmail.com (celle définie dans ADMIN_EMAIL ci-dessus —
#      important : tant qu'aucun nom de domaine n'est vérifié sur Resend,
#      les emails ne peuvent être envoyés qu'à l'adresse du compte Resend).
#   2. Dans le tableau de bord Resend : API Keys → Create API Key.
#   3. Collez la clé (commence par "re_") ci-dessous.
RESEND_API_KEY=
#
# OPTION B — SMTP Gmail classique (utilisée seulement si RESEND_API_KEY est
# vide). Avec Gmail :
#   1. Activez la validation en 2 étapes sur le compte Google qui enverra les
#      emails : https://myaccount.google.com/security
#   2. Créez un "mot de passe d'application" :
#      https://myaccount.google.com/apppasswords (choisir "Autre", ex: "SyCol API")
#   3. Collez le mot de passe généré (16 caractères) dans SMTP_PASS ci-dessous
#      (PAS votre mot de passe Gmail habituel — les mots de passe classiques
#      ne fonctionnent plus pour ça depuis 2022).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse-gmail@gmail.com
SMTP_PASS=le-mot-de-passe-d-application-16-caracteres
